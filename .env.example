# ── APAAR Student Academic Platform — Environment Template ──
# Copy this file to .env.local and fill in real values.

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=APAAR Student Academic Platform
APP_URL=http://localhost:3000

# Database Configuration (MongoDB Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/apaar_platform

# Authentication Secret (min 16 characters — generate with: openssl rand -base64 64)
AUTH_SECRET=change_me_to_a_long_secure_secret_key_minimum_32_characters
JWT_REFRESH_SECRET=change_me_to_another_long_secure_secret_key

# Client URL (CORS)
CLIENT_URL=http://localhost:5173

# Document Storage Configuration
# Options: cloudinary | local
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_STORAGE_BUCKET=apaar-documents
STORAGE_LOCAL_PATH=./uploads
MAX_FILE_SIZE_MB=5

# Cloudinary Configuration (required if DOCUMENT_STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
FROM_NAME=APAAR Platform

# Redis Configuration (optional — for caching & rate limiting)
REDIS_URL=redis://127.0.0.1:6379
